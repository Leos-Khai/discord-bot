# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

# Discord Bot Token (Get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Command Prefix
BOT_PREFIX=!

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=discord_bot

# YouTube API Key (Optional - for notifications cog)
# Get from https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Twitch API Keys (Optional - for notifications cog)
# Get from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# AI replies and image descriptions (Optional - admins turn them on per server with !description on
# and pick a provider with !description model claude|gemini). Set up Claude, Gemini, or both.
# Claude: get a key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional - defaults to claude-haiku-5-5 at medium effort. Effort is low, medium, high, xhigh, or max.
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=medium
# Gemini: get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model names change often; pick a current one from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional - when set, the bot replies to every image posted in a server with descriptions on, using this prompt. Leave it out to turn image descriptions off.DESCRIPTION_IMAGE_PROMPT="Describe this image for someone who can't see it. Start with the main subject, then mention any readable text, people, and notable details. Keep it to two or three sentences."
